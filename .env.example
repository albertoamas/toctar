# Copiar a .env y completar. Nunca subir .env al repositorio.
# Guardar en UTF-8: con otra codificación las tildes y la ñ llegan rotas (por ejemplo, "Dueño").

# PostgreSQL (en desarrollo, el de docker-compose.yml)
DATABASE_URL=postgres://toctar:toctar@localhost:5432/toctar

# Autenticación (Better Auth). Secreto distinto en cada entorno, de 32 caracteres o más:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública de la app en ese entorno
BETTER_AUTH_URL=http://localhost:3000

# Primer usuario dueño: se crea al arrancar si la base no tiene usuarios.
# Después de crearlo, estas tres variables se pueden borrar.
DUENO_INICIAL_USUARIO=dueno
DUENO_INICIAL_NOMBRE=Dueño de prueba
DUENO_INICIAL_CONTRASENA=

# Almacenamiento S3 de fotos y PDF.
# Desarrollo: RustFS de docker-compose.yml. Pruebas y producción: Cloudflare R2
# (S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com, S3_URL_PUBLICA = dominio público del bucket).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=toctar-dev
S3_SECRET_ACCESS_KEY=toctar-dev-secreto
S3_BUCKET=toctar
S3_URL_PUBLICA=http://localhost:9000/toctar
