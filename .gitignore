# Regla general: se versiona el código, la configuración compartida y la documentación.
# No se versiona nada generado, nada personal y ningún secreto.

# ── Dependencias ──────────────────────────────────────────
/node_modules/

# ── Build y archivos generados ────────────────────────────
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ── Pruebas ───────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Secretos y variables de entorno ───────────────────────
# Solo .env.example (sin valores reales) va al repositorio.
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── Datos locales ─────────────────────────────────────────
# Respaldos o volcados de la base hechos a mano: pueden tener datos reales de clientes.
*.sql.gz
*.dump
/respaldos/

# ── Claude Code ───────────────────────────────────────────
# .claude/settings.json (plugins del proyecto) sí se versiona.
.claude/settings.local.json
CLAUDE.local.md

# ── Editores ──────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ── Sistema operativo ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Registros ─────────────────────────────────────────────
*.log
npm-debug.log*

# ── Plataformas que no usamos (por si alguien las prueba) ─
.vercel
